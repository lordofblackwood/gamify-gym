{
  "name": "powerlevel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:dashboard && npm run build:bodyweight",
    "build:dashboard": "vite build",
    "build:bodyweight": "vite build --config vite.bodyweight.config.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.6",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
